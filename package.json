{
  "name": "bc-aiui-features",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@sap/cds": "^8",
    "express": "^4",
    "@sap/xssec": "^4",
    "ui5-cap-ai-features-plugin": "^1.0.0"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.8.0",
    "@cap-js/sqlite": "^1",
    "@sap/cds-dk": "^8",
    "cds-plugin-ui5": "^0.13.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.29"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-aidemo": "cds watch --open be.wl.ai.aidemo/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-hybrid": "cds watch --profile hybrid --open be.wl.ai.aidemo/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-hybrid-infra": "cds watch --profile hybrid-infra --open be.wl.ai.aidemo/index.html?sap-ui-xx-viewCache=false --livereload false",
    "bind": "cds bind AICORE --to aicore --profile hybrid",
    "undeploy": "cf undeploy bc-aiui-features --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "cds": {
    "requires": {
      "auth": {
        "kind": "xsuaa",
        "[development]": {
          "kind": "dummy"
        }
      },
      "connectivity": true,
      "destinations": true,
      "html5-repo": true
    }
  },
  "workspaces": [
    "app/*",
    "ui5-cap-ai-features-plugin"
  ]
}
