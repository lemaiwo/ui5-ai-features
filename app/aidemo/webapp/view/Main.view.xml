<mvc:View controllerName="be.wl.ai.aidemo.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:ai="be.wl.ai">
    <Page id="page" title="{i18n>title}">
        <content>
            <VBox class="sapUiMediumMargin">
                <Title text="AI-Powered Text Tools" level="H2" class="sapUiSmallMarginBottom" />
                <Text text="Enter text in the area below and use the AI tools to process it." class="sapUiSmallMarginBottom" />

                <Panel headerText="AI Text Processing" class="sapUiSmallMarginTop">
                    <VBox class="sapUiSmallMargin">
                        <TextArea
                            id="aiSourceText"
                            value="{/sourceText}"
                            width="100%"
                            rows="8"
                            placeholder="Enter or paste the text you want to process with AI..."
                            growing="true"
                            growingMaxLines="15"
                            class="sapUiSmallMarginBottom" />
                        <OverflowToolbar>
                            <ai:AIPolishButton
                                id="demoPolishButton"
                                text="Polish"
                                value="{/sourceText}" />
                            <ai:AISummarizeButton
                                id="demoSummarizeButton"
                                text="Summarize"
                                value="{/sourceText}" />
                            <ai:AITranslateButton
                                id="demoTranslateButton"
                                text="Translate"
                                value="{/sourceText}" />
                            <ai:AIToneButton
                                id="demoToneButton"
                                text="Change Tone"
                                value="{/sourceText}" />
                            <ToolbarSpacer />
                            <ai:AIGenerateButton
                                id="demoGenerateButton"
                                text="Generate"
                                value="{/sourceText}" />
                        </OverflowToolbar>
                    </VBox>
                </Panel>

                <Panel headerText="Validation &amp; Analysis Controls" class="sapUiSmallMarginTop">
                    <VBox class="sapUiSmallMargin">
                        <OverflowToolbar>
                            <ai:AISpellCheckButton
                                id="demoSpellCheckButton"
                                text="Spell Check"
                                value="{/sourceText}" />
                            <ai:AIExtractKeywordsButton
                                id="demoKeywordsButton"
                                text="Extract Keywords"
                                value="{/sourceText}" />
                        </OverflowToolbar>
                    </VBox>
                </Panel>

                <Panel headerText="Compare Texts" class="sapUiSmallMarginTop">
                    <VBox class="sapUiSmallMargin">
                        <HBox width="100%">
                            <VBox width="50%" class="sapUiTinyMarginEnd">
                                <Label text="Text 1" labelFor="compareText1" />
                                <TextArea
                                    id="compareText1"
                                    value="{/compareText1}"
                                    width="100%"
                                    rows="6"
                                    placeholder="Enter the first text..."
                                    growing="true"
                                    growingMaxLines="10" />
                            </VBox>
                            <VBox width="50%">
                                <Label text="Text 2" labelFor="compareText2" />
                                <TextArea
                                    id="compareText2"
                                    value="{/compareText2}"
                                    width="100%"
                                    rows="6"
                                    placeholder="Enter the second text..."
                                    growing="true"
                                    growingMaxLines="10" />
                            </VBox>
                        </HBox>
                        <OverflowToolbar class="sapUiSmallMarginTop">
                            <ai:AICompareTexts
                                id="demoCompareButton"
                                text="Compare Texts"
                                value1="{/compareText1}"
                                value2="{/compareText2}" />
                        </OverflowToolbar>
                    </VBox>
                </Panel>

                <Panel headerText="AI Input Suggestion Demo" class="sapUiSmallMarginTop">
                    <VBox class="sapUiSmallMargin">
                        <Text text="Type some text in the field below, then click the AI button to get an improved suggestion." class="sapUiSmallMarginBottom" />
                        <HBox alignItems="Center">
                            <TextArea
                                id="demoInputField"
                                value="{/suggestionText}"
                                width="400px"
                                rows="3"
                                placeholder="Type something here..."
                                class="sapUiTinyMarginEnd" />
                            <ai:AIInputSuggestion
                                id="demoInputSuggestion"
                                value="{/suggestionText}" />
                        </HBox>
                    </VBox>
                </Panel>

                <Panel headerText="AI Auto-Complete Demo" class="sapUiSmallMarginTop">
                    <VBox class="sapUiSmallMargin">
                        <Text text="Start writing a partial sentence, then click the complete button to have AI finish it." class="sapUiSmallMarginBottom" />
                        <HBox alignItems="Center">
                            <TextArea
                                id="demoAutoCompleteField"
                                value="{/autoCompleteText}"
                                width="400px"
                                rows="3"
                                placeholder="Start typing a sentence..."
                                class="sapUiTinyMarginEnd" />
                            <ai:AIAutoComplete
                                id="demoAutoComplete"
                                value="{/autoCompleteText}" />
                        </HBox>
                    </VBox>
                </Panel>

                <Panel headerText="AI Sentiment Analysis Demo" class="sapUiSmallMarginTop">
                    <VBox class="sapUiSmallMargin">
                        <Text text="Enter text and click Analyze to detect its sentiment." class="sapUiSmallMarginBottom" />
                        <TextArea
                            id="sentimentInputField"
                            value="{/sentimentText}"
                            width="100%"
                            rows="3"
                            placeholder="Enter text to analyze sentiment..."
                            class="sapUiSmallMarginBottom" />
                        <ai:AISentimentIndicator
                            id="demoSentimentIndicator"
                            text="{/sentimentText}"
                            showButton="true"
                            buttonText="Analyze Sentiment" />
                    </VBox>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>
