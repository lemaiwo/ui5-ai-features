<mvc:View controllerName="com.eliagroup.ai.aidemo.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:ai="com.eliagroup.ai.aidemo.control">
    <Page id="page" title="{i18n>title}">
        <headerContent>
            <ai:AIPolishButton
                id="polishButton"
                text="Polish Text"
                dialogTitle="Polish Text with AI"
                prompt="Polish and improve this text. Fix grammar, improve clarity, and make it more professional while keeping the original meaning."
                aiModelName="ai" />
            <ai:AISummarizeButton
                id="summarizeButton"
                text="Summarize Text"
                dialogTitle="Summarize Text with AI"
                prompt="Summarize the following text concisely. Capture the key points and main ideas in a clear, brief summary."
                aiModelName="ai" />
            <ai:AITranslateButton
                id="translateButton"
                text="Translate Text"
                dialogTitle="Translate Text with AI"
                aiModelName="ai" />
        </headerContent>
        <content>
            <VBox class="sapUiMediumMargin">
                <Title text="AI-Powered Text Tools" level="H2" class="sapUiSmallMarginBottom" />
                <Text text="Use the AI controls in the header or the demos below to process text with artificial intelligence." class="sapUiSmallMarginBottom" />

                <Panel headerText="Text Transformation Controls" class="sapUiSmallMarginTop">
                    <VBox class="sapUiSmallMargin">
                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                            <ai:AIPolishButton
                                id="demoPolishButton"
                                text="Polish Text"
                                aiModelName="ai"
                                class="sapUiTinyMarginEnd" />
                            <Text text="Polish and improve your text — fix grammar, improve clarity, make it professional" />
                        </HBox>
                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                            <ai:AISummarizeButton
                                id="demoSummarizeButton"
                                text="Summarize Text"
                                aiModelName="ai"
                                class="sapUiTinyMarginEnd" />
                            <Text text="Summarize long text into key points" />
                        </HBox>
                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                            <ai:AITranslateButton
                                id="demoTranslateButton"
                                text="Translate Text"
                                aiModelName="ai"
                                class="sapUiTinyMarginEnd" />
                            <Text text="Translate text into 12+ languages with a language selector" />
                        </HBox>
                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                            <ai:AIToneButton
                                id="demoToneButton"
                                text="Change Tone"
                                aiModelName="ai"
                                class="sapUiTinyMarginEnd" />
                            <Text text="Rewrite text in a different tone (formal, casual, persuasive, empathetic, etc.)" />
                        </HBox>
                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                            <ai:AIGenerateButton
                                id="demoGenerateButton"
                                text="Generate Text"
                                aiModelName="ai"
                                class="sapUiTinyMarginEnd" />
                            <Text text="Generate text from a brief description or instructions" />
                        </HBox>
                    </VBox>
                </Panel>

                <Panel headerText="Validation &amp; Analysis Controls" class="sapUiSmallMarginTop">
                    <VBox class="sapUiSmallMargin">
                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                            <ai:AISpellCheckButton
                                id="demoSpellCheckButton"
                                text="Spell Check"
                                aiModelName="ai"
                                class="sapUiTinyMarginEnd" />
                            <Text text="Check spelling and grammar — preserves your style, only fixes errors, shows corrections list" />
                        </HBox>
                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                            <ai:AIExtractKeywordsButton
                                id="demoKeywordsButton"
                                text="Extract Keywords"
                                aiModelName="ai"
                                class="sapUiTinyMarginEnd" />
                            <Text text="Extract keywords and tags from text, displayed as tokens" />
                        </HBox>
                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                            <ai:AICompareTexts
                                id="demoCompareButton"
                                text="Compare Texts"
                                aiModelName="ai"
                                class="sapUiTinyMarginEnd" />
                            <Text text="Compare two texts side-by-side with AI-powered difference analysis" />
                        </HBox>
                    </VBox>
                </Panel>

                <Panel headerText="AI Input Suggestion Demo" class="sapUiSmallMarginTop">
                    <VBox class="sapUiSmallMargin">
                        <Text text="Type some text in the field below, then click the AI button to get an improved suggestion." class="sapUiSmallMarginBottom" />
                        <HBox alignItems="Center">
                            <TextArea
                                id="demoInputField"
                                width="400px"
                                rows="3"
                                placeholder="Type something here..."
                                class="sapUiTinyMarginEnd" />
                            <ai:AIInputSuggestion
                                id="demoInputSuggestion"
                                target="demoInputField"
                                aiModelName="ai" />
                        </HBox>
                    </VBox>
                </Panel>

                <Panel headerText="AI Auto-Complete Demo" class="sapUiSmallMarginTop">
                    <VBox class="sapUiSmallMargin">
                        <Text text="Start writing a partial sentence, then click the complete button to have AI finish it." class="sapUiSmallMarginBottom" />
                        <HBox alignItems="Center">
                            <TextArea
                                id="demoAutoCompleteField"
                                width="400px"
                                rows="3"
                                placeholder="Start typing a sentence..."
                                class="sapUiTinyMarginEnd" />
                            <ai:AIAutoComplete
                                id="demoAutoComplete"
                                target="demoAutoCompleteField"
                                aiModelName="ai" />
                        </HBox>
                    </VBox>
                </Panel>

                <Panel headerText="AI Sentiment Analysis Demo" class="sapUiSmallMarginTop">
                    <VBox class="sapUiSmallMargin">
                        <Text text="Enter text and click Analyze to detect its sentiment." class="sapUiSmallMarginBottom" />
                        <TextArea
                            id="sentimentInputField"
                            width="100%"
                            rows="3"
                            placeholder="Enter text to analyze sentiment..."
                            liveChange=".onSentimentTextChange"
                            class="sapUiSmallMarginBottom" />
                        <ai:AISentimentIndicator
                            id="demoSentimentIndicator"
                            aiModelName="ai"
                            showButton="true"
                            buttonText="Analyze Sentiment" />
                    </VBox>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>
